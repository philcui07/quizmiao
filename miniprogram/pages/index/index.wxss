/* 首页样式 */
.section-title { font-size: 22px; font-weight: 700; margin-bottom: 6px; }
.section-desc { font-size: 14px; color: var(--text3); margin-bottom: 16px; }

/* Tab 切换 */
.input-tabs { display: flex; margin-bottom: 14px; border-bottom: 2px solid var(--line2); }
.input-tab {
  flex: 1; padding: 10px; text-align: center;
  font-size: 15px; color: var(--text3); font-weight: 500;
  border-bottom: 2px solid transparent; margin-bottom: -2px;
}
.input-tab.active { color: var(--primary); border-bottom-color: var(--primary); }

/* 输入框 */
.input-area {
  background: var(--card); border: 1px solid var(--line); border-radius: 8px;
  padding: 12px; font-size: 14px; width: 100%;
  box-sizing: border-box; min-height: 120px;
}
.input-inline { min-height: 44px; height: 44px; }

/* 多链接 */
.url-row { display: flex; gap: 8px; margin-bottom: 8px; align-items: center; }
.url-row .input-inline { flex: 1; padding: 10px 14px; min-height: 44px; }
.url-del {
  width: 36px; height: 36px; border-radius: 8px;
  background: var(--line2); display: flex;
  align-items: center; justify-content: center;
  font-size: 18px; color: var(--text3); flex-shrink: 0;
}
.url-del:active { background: #FFE0E0; color: var(--danger); }

/* 操作区 */
.action-row {
  display: flex; gap: 10px; align-items: center;
  flex-wrap: wrap; margin-top: 4px;
}
.qty-row { display: flex; align-items: center; gap: 6px; font-size: 14px; }
.qty-label { color: var(--text3); }
.qty-picker {
  border: 1px solid var(--line); border-radius: 8px;
  padding: 8px 14px; font-size: 14px; background: var(--card);
}

/* 底部 */
.footer-text {
  font-size: 12px; color: var(--text3); text-align: center;
  padding: 24px 0;
}
