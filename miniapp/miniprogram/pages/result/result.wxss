.result-wrap { text-align: center; }
.section-title { font-size: 18px; font-weight: 700; }
.score-circle {
  width: 120px; height: 120px; border-radius: 50%;
  background: #F0FFF4; margin: 16px auto;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
}
.score-num { font-size: 40px; font-weight: 800; color: var(--primary); line-height: 1; }
.score-pct { font-size: 12px; color: var(--text3); }
.result-desc { font-size: 14px; color: var(--text3); margin-bottom: 20px; }
.result-btns { display: flex; gap: 10px; flex-wrap: wrap; justify-content: center; }

.wrong-section { margin-top: 0; }
.wrong-item { border-top: 1px solid var(--line2); padding: 12px 0; font-size: 14px; }
.wq { font-weight: 600; margin-bottom: 4px; }
.wa { color: var(--danger); }
.wc { color: var(--primary-d); }
.we { font-size: 12px; color: var(--text3); }
