.section-title { font-size: 22px; font-weight: 700; margin-bottom: 6px; }
.section-desc { font-size: 14px; color: var(--text3); margin-bottom: 16px; }
.history-initializing { padding: 56px 16px; color: var(--text3); font-size: 13px; text-align: center; }

.history-login { margin-top: 32px; padding: 28px 24px 20px; text-align: center; }
.login-brand { width: 48px; height: 48px; margin: 0 auto 14px; border-radius: 8px; background: var(--primary); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 800; }
.history-login-title { font-size: 18px; font-weight: 700; }
.history-login-desc { margin: 6px 0 20px; color: var(--text3); font-size: 13px; line-height: 1.6; }
.history-login-modal { max-width: 400px; padding: 28px 24px 20px; border-radius: 8px; }
.login-divider { display: flex; align-items: center; gap: 10px; margin: 4px 0 14px; color: var(--text3); font-size: 12px; }
.login-divider::before, .login-divider::after { content: ''; flex: 1; height: 1px; background: var(--line); }
.login-phone-field { min-height: 48px; display: flex; align-items: center; border: 1px solid var(--line); border-radius: 8px; background: #fff; overflow: hidden; }
.country-code { padding: 0 12px; border-right: 1px solid var(--line); color: var(--text2); font-weight: 600; }
.login-phone-field input { min-width: 0; flex: 1; height: 46px; padding: 0 12px; font-size: 16px; text-align: left; }
.login-status { min-height: 20px; margin: 6px 0 12px; color: var(--text3); font-size: 12px; text-align: left; }
.manual-login-submit { min-height: 48px; }
.login-cancel { background: transparent; color: var(--text3); }

.history-tabs { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; margin-top: 16px; padding: 4px; border-radius: 8px; background: var(--line2); }
.history-tab { min-height: 36px; border-radius: 6px; display: flex; align-items: center; justify-content: center; color: var(--text3); font-size: 14px; font-weight: 600; }
.history-tab.active { background: var(--card); color: var(--text); box-shadow: 0 1px 3px rgba(0,0,0,.08); }

.history-status, .empty-state { color: var(--text3); text-align: center; padding: 48px 16px; font-size: 14px; }
.history-error { color: var(--danger); }
.empty-state.compact { padding: 24px 16px; }

.history-list { display: block; width: auto; margin: 0; }
.history-card { display: block; width: auto; max-width: none; min-height: 104px; margin: 0 16px 10px; padding: 14px 16px; box-sizing: border-box; background: var(--card); border: 0; border-radius: 8px; box-shadow: 0 1px 3px rgba(0,0,0,.06); text-align: left; color: var(--text); }
.history-card-active { transform: scale(.98); }
.history-card-header { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 8px; }
.history-title { min-width: 0; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 14px; font-weight: 600; }
.history-stats { display: flex; flex-wrap: wrap; gap: 12px; color: var(--text3); font-size: 12px; }
.history-score { color: var(--text); font-weight: 600; }
.muted { color: var(--text3); }
.history-date { color: var(--text3); font-size: 11px; margin-top: 4px; }
.tag-self { background: #DBEAFE; color: #1E40AF; }
.tag-shared { background: #FEF3C7; color: #92400E; }
.tag-expired { background: #EEEEEE; color: #666666; }
