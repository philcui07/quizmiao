.profile-page { padding-top: 1px; }
.profile-initializing { padding: 56px 16px; color: var(--text3); font-size: 13px; text-align: center; }
.section-title { font-size: 18px; font-weight: 700; margin-bottom: 6px; }
.section-desc { color: var(--text3); font-size: 13px; margin-bottom: 18px; }
.profile-login { margin-top: 32px; padding: 28px 24px 20px; text-align: center; }
.login-brand { width: 48px; height: 48px; margin: 0 auto 14px; border-radius: 8px; background: var(--primary); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 800; }
.login-divider { display: flex; align-items: center; gap: 10px; margin: 4px 0 14px; color: var(--text3); font-size: 12px; }
.login-divider::before, .login-divider::after { content: ''; flex: 1; height: 1px; background: var(--line); }
.login-phone-field { min-height: 48px; display: flex; align-items: center; border: 1px solid var(--line); border-radius: 8px; background: #fff; overflow: hidden; }
.country-code { padding: 0 12px; border-right: 1px solid var(--line); color: var(--text2); font-weight: 600; }
.login-phone-field input { min-width: 0; flex: 1; height: 46px; padding: 0 12px; font-size: 16px; text-align: left; }
.login-status { min-height: 20px; margin: 6px 0 12px; color: var(--text3); font-size: 12px; text-align: left; }
.login-error { color: var(--danger); }
.manual-login-submit { min-height: 48px; }
.security-note { margin-top: 14px; color: var(--text3); font-size: 11px; line-height: 1.5; }
.account-card { display: flex; align-items: center; gap: 14px; padding: 22px 18px; }
.account-avatar { width: 52px; height: 52px; flex: 0 0 auto; border-radius: 50%; background: var(--primary); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 800; }
.account-copy { min-width: 0; flex: 1; }
.account-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 18px; font-weight: 700; }
.account-phone { color: var(--text3); font-size: 13px; margin-top: 2px; }
.menu-card { padding: 0; overflow: hidden; }
.menu-row { position: relative; width: 100%; min-height: 64px; margin: 0; padding: 12px 48px 12px 18px; box-sizing: border-box; border-radius: 0; background: transparent; color: var(--text); display: flex; align-items: center; justify-content: flex-start; text-align: left; }
.menu-row + .menu-row { border-top: 1px solid var(--line2); }
.menu-row-active { background: var(--line2); }
.menu-title { width: 100%; font-size: 15px; font-weight: 600; text-align: left; }
.menu-chevron { position: absolute; right: 18px; top: 50%; color: var(--text3); font-size: 22px; line-height: 1; transform: translateY(-50%); }
.menu-row.danger { color: var(--danger); }
