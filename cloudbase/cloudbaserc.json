{
  "envId": "quizmiao-web-d7g9642jpcaa90745",
  "version": "1.1.0",
  "functions": [
    {
      "name": "quiz-generate",
      "timeout": 60,
      "env": {
        "DEEPSEEK_API_KEY": "",
        "DEEPSEEK_MODEL": "deepseek-v4-flash",
        "QUIZ_BATCH_SIZE": "2",
        "QUIZ_BATCH_CONCURRENCY": "5",
        "QUIZ_BATCH_ATTEMPTS": "2",
        "QUIZ_UPSTREAM_TIMEOUT_MS": "10000",
        "QUIZ_CACHE_TTL_MS": "600000",
        "QUIZ_RATE_LIMIT_MAX": "60"
      }
    },
    {
      "name": "page-fetch",
      "timeout": 15
    },
    {
      "name": "share-manage",
      "timeout": 10
    },
    {
      "name": "history-manage",
      "timeout": 10
    },
    {
      "name": "share-result",
      "timeout": 10
    },
    {
      "name": "profile-manage",
      "timeout": 10
    },
    {
      "name": "phone-auth",
      "timeout": 10,
      "env": {
        "PHONE_AUTH_PROVIDER": "disabled",
        "PHONE_AUTH_VERIFY_URL": "",
        "PHONE_AUTH_APP_ID": "",
        "PHONE_AUTH_VERIFY_SECRET": "",
        "PHONE_HASH_SECRET": ""
      }
    }
  ],
  "collections": [
    {
      "name": "users",
      "permissions": {
        "read": false,
        "write": false
      }
    },
    {
      "name": "phone_bindings",
      "permissions": {
        "read": false,
        "write": false
      }
    },
    {
      "name": "quiz_history",
      "permissions": {
        "read": false,
        "write": false
      }
    },
    {
      "name": "quiz_attempts",
      "permissions": {
        "read": false,
        "write": false
      }
    },
    {
      "name": "shares",
      "permissions": {
        "read": false,
        "write": false
      }
    },
    {
      "name": "share_results",
      "permissions": {
        "read": false,
        "write": false
      }
    }
  ],
  "indexes": [
    { "collection": "quiz_history", "fields": ["owner_id", "created_at"] },
    { "collection": "quiz_attempts", "fields": ["owner_id", "history_id", "created_at"] },
    { "collection": "quiz_attempts", "fields": ["owner_id", "attempt_id"] },
    { "collection": "shares", "fields": ["owner_id", "created_at"] },
    { "collection": "share_results", "fields": ["share_id", "sharer_id", "created_at"] },
    { "collection": "share_results", "fields": ["share_id", "attempt_id"] }
  ]
}
